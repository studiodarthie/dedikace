# Application
NEXT_PUBLIC_APP_URL=https://dedikace.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+237XXXXXXXXX
ADMIN_EMAILS=toi@exemple.com

# Neon (chaîne de connexion « pooled » du tableau de bord Neon)
DATABASE_URL=

# Cloudflare R2 (bucket privé `songs`)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=songs

# Auth.js (générer avec : npx auth secret)
AUTH_SECRET=

# Resend (e-mails : lien magique admin, alertes)
RESEND_API_KEY=
EMAIL_FROM="Dédikace <noreply@dedikace.com>"

# IA
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
ELEVENLABS_API_KEY=

# Tranzak (clés SAND_... en sandbox)
TRANZAK_MODE=sandbox
TRANZAK_APP_ID=
TRANZAK_APP_KEY=
# Clé « Auth key » du webhook Tranzak. Dans ce fichier, écrire chaque $ sous la forme \$ (pas sur Vercel).
TRANZAK_WEBHOOK_AUTH_KEY=

# Inngest (en local : INNGEST_DEV=1 et « npx inngest-cli@latest dev »)
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Prix (XAF, entiers)
PRICE_MOMO_XAF=3000
PRICE_CARD_XAF=4000
