{
  "name": "dedikace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:orders": "tsx --env-file=.env.local --conditions=react-server scripts/test-orders.ts",
    "check:tranzak": "tsx --env-file=.env.local --conditions=react-server scripts/check-tranzak.ts",
    "test:payments": "tsx --env-file=.env.local --conditions=react-server scripts/test-payments.ts",
    "test:lyrics": "tsx --env-file=.env.local --conditions=react-server scripts/test-lyrics.ts",
    "check:services": "tsx --env-file=.env.local scripts/check-services.ts",
    "test:music": "tsx --env-file=.env.local --conditions=react-server scripts/test-music.ts",
    "test:generate": "tsx --env-file=.env.local --conditions=react-server scripts/test-generate.ts",
    "seed:song": "tsx --env-file=.env.local --conditions=react-server scripts/seed-song.ts",
    "test:admin": "tsx --env-file=.env.local --conditions=react-server scripts/test-admin.ts",
    "db:migrate:prod": "MIGRATE_TARGET=prod drizzle-kit migrate",
    "make:examples": "tsx --env-file=.env.local --conditions=react-server scripts/make-examples.ts",
    "make:style-samples": "tsx --env-file=.env.local --conditions=react-server scripts/make-style-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "tranzak-node": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inngest/test": "^1.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
